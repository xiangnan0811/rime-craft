{
  "name": "rime-craft",
  "version": "1.0.0",
  "description": "Rime 输入法可视化配置编辑器与教程站，正式支持 macOS / Windows 导入导出",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
